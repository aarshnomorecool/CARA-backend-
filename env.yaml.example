# Cloud Run env vars — copy this to env.yaml and fill in real values, then
# deploy with: gcloud run deploy --source . --env-vars-file env.yaml ...
# env.yaml is gitignored (holds secrets), same pattern as .env/.env.example.

# Supabase Transaction pooler connection string (Project Settings > Database
# > Connection string > Transaction mode, port 6543) — NOT the direct 5432
# connection. See CLAUDE(CARA-BACKEND).md's Database section for why.
DATABASE_URL: "postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres"
OPENWEATHER_API_KEY: "your_openweathermap_key_here"
GEMINI_API_KEY: "your_gemini_key_here"
GOOGLE_PLACES_API_KEY: "your_google_places_key_here"
